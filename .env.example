# Copy this file to .env for local development.
# On Hostinger, enter the same names and values in the Node.js app's environment variables.

NODE_ENV=production
PORT=3000

# From hPanel > Databases (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u123456789_nebula
DB_USER=u123456789_nebula
DB_PASSWORD=change-me

# A long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me

# Absolute path OUTSIDE the app folder, so GitHub redeploys never delete your files.
UPLOAD_DIR=/home/u123456789/nebula-uploads

# Largest single file, in MB
MAX_UPLOAD_MB=100

# Optional: lets the iOS "Save to Nebula" Shortcut save entries without a browser login.
# 32+ characters. It can ONLY create entries (never read, edit or delete).
# Generate one with:  openssl rand -hex 32
CAPTURE_TOKEN=

# Optional: email capture. Nebula checks this mailbox every few minutes and turns
# each email into entries (see README "Save by email").
MAIL_USER=
MAIL_PASSWORD=
# Only emails FROM these addresses are accepted (comma-separated):
MAIL_ALLOWED_FROM=
# Defaults below match Hostinger Email; change only if you use another provider.
# MAIL_IMAP_HOST=imap.hostinger.com
# MAIL_IMAP_PORT=993
# MAIL_POLL_MINUTES=5
