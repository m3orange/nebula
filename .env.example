# Copy this file to .env for local development.
# On Hostinger, enter the same names and values in the Node.js app's environment variables.

NODE_ENV=production
PORT=3000

# From hPanel > Databases (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u123456789_nebula
DB_USER=u123456789_nebula
DB_PASSWORD=change-me

# A long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me

# Absolute path OUTSIDE the app folder, so GitHub redeploys never delete your files.
UPLOAD_DIR=/home/u123456789/nebula-uploads

# Largest single file, in MB
MAX_UPLOAD_MB=100
